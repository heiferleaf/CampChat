<Window x:Class="CampChat.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        Title="营地聊天" Width="408" Height="260" MinWidth="320" MinHeight="188" WindowStyle="None" ResizeMode="CanResize"
        Icon="Assets/CampChat.ico" Topmost="True" Background="{StaticResource ShellSurface}" Foreground="{StaticResource Paper}"
        Language="zh-CN" FontFamily="{StaticResource InterfaceFont}" FontSize="15"
        UseLayoutRounding="True" SnapsToDevicePixels="True" TextOptions.TextFormattingMode="Display" TextOptions.TextRenderingMode="Grayscale"
        SourceInitialized="OnSourceInitialized" Loaded="OnLoaded" PreviewKeyDown="OnPreviewKeyDown" Closing="OnClosing">
    <shell:WindowChrome.WindowChrome>
        <shell:WindowChrome CaptionHeight="0" ResizeBorderThickness="6" GlassFrameThickness="0"/>
    </shell:WindowChrome.WindowChrome>
    <Window.Resources>
        <BorderGapMaskConverter x:Key="GroupLegendGap"/>
        <Style x:Key="ScrollTrackButton" TargetType="RepeatButton">
            <Setter Property="Focusable" Value="False"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RepeatButton"><Border Background="Transparent"/></ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style TargetType="ScrollBar">
            <Setter Property="Width" Value="11"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Focusable" Value="False"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ScrollBar">
                        <Grid Background="{TemplateBinding Background}" Margin="2,4,2,4">
                            <Border CornerRadius="3" Background="{StaticResource ControlSurface}" Opacity="0.6"/>
                            <Track x:Name="PART_Track" IsDirectionReversed="True">
                                <Track.DecreaseRepeatButton>
                                    <RepeatButton Style="{StaticResource ScrollTrackButton}" Command="ScrollBar.PageUpCommand"/>
                                </Track.DecreaseRepeatButton>
                                <Track.Thumb>
                                    <Thumb>
                                        <Thumb.Template>
                                            <ControlTemplate TargetType="Thumb">
                                                <Border x:Name="Grip" CornerRadius="4" Background="#8E6C51"/>
                                                <ControlTemplate.Triggers>
                                                    <Trigger Property="IsMouseOver" Value="True">
                                                        <Setter TargetName="Grip" Property="Background" Value="{StaticResource SoftAccent}"/>
                                                    </Trigger>
                                                    <Trigger Property="IsDragging" Value="True">
                                                        <Setter TargetName="Grip" Property="Background" Value="{StaticResource Amber}"/>
                                                    </Trigger>
                                                </ControlTemplate.Triggers>
                                            </ControlTemplate>
                                        </Thumb.Template>
                                    </Thumb>
                                </Track.Thumb>
                                <Track.IncreaseRepeatButton>
                                    <RepeatButton Style="{StaticResource ScrollTrackButton}" Command="ScrollBar.PageDownCommand"/>
                                </Track.IncreaseRepeatButton>
                            </Track>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="Heading" TargetType="TextBlock">
            <Setter Property="FontSize" Value="17"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
        </Style>
        <Style x:Key="SettingsGroup" TargetType="GroupBox">
            <Setter Property="Foreground" Value="{StaticResource Paper}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="GroupBox">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>
                            <Border Grid.RowSpan="2" Margin="0,11,0,0" CornerRadius="9" Background="{StaticResource GroupSurface}"/>
                            <Border x:Name="Outline" Grid.RowSpan="2" Margin="0,11,0,0" CornerRadius="9"
                                    BorderThickness="1" BorderBrush="{StaticResource GroupLine}">
                                <Border.OpacityMask>
                                    <MultiBinding Converter="{StaticResource GroupLegendGap}" ConverterParameter="17">
                                        <Binding ElementName="Legend" Path="ActualWidth"/>
                                        <Binding ElementName="Outline" Path="ActualWidth"/>
                                        <Binding ElementName="Outline" Path="ActualHeight"/>
                                    </MultiBinding>
                                </Border.OpacityMask>
                            </Border>
                            <Border x:Name="Legend" Margin="17,0,0,2" Padding="5,0" HorizontalAlignment="Left" Height="22">
                                <ContentPresenter ContentSource="Header" VerticalAlignment="Center"/>
                            </Border>
                            <ContentPresenter Grid.Row="1" Margin="21,0,16,5" ContentSource="Content"/>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="SettingsLabel" TargetType="TextBlock">
            <Setter Property="FontSize" Value="15"/>
            <Setter Property="FontWeight" Value="Medium"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>
        <DataTemplate x:Key="ShortcutKeycaps">
            <ItemsControl ItemsSource="{Binding}">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate><WrapPanel Orientation="Horizontal"/></ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border Background="{StaticResource ControlSurface}" BorderBrush="{StaticResource Line}" BorderThickness="1"
                                CornerRadius="6" MinWidth="42" Height="24" Padding="7,0" Margin="0,0,13,0">
                            <TextBlock Text="{Binding}" FontSize="14" FontWeight="Medium" Foreground="{StaticResource Paper}"
                                       VerticalAlignment="Center" TextAlignment="Center"/>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </DataTemplate>
        <Style TargetType="TextBox">
            <Setter Property="Foreground" Value="{StaticResource Paper}"/>
            <Setter Property="Background" Value="{StaticResource InputSurface}"/>
            <Setter Property="BorderBrush" Value="{StaticResource Line}"/>
            <Setter Property="CaretBrush" Value="{StaticResource Amber}"/>
            <Setter Property="Padding" Value="11,0"/>
            <Setter Property="Height" Value="41"/>
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TextBox">
                        <Border x:Name="FieldFrame" Background="{TemplateBinding Background}" CornerRadius="7"
                                BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="1">
                            <ScrollViewer x:Name="PART_ContentHost" VerticalAlignment="Center"
                                          Margin="{TemplateBinding Padding}"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="FieldFrame" Property="BorderBrush" Value="{StaticResource Amber}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style TargetType="Button">
            <Setter Property="Foreground" Value="{StaticResource Paper}"/>
            <Setter Property="Background" Value="{StaticResource ControlSurface}"/>
            <Setter Property="BorderBrush" Value="{StaticResource Line}"/>
            <Setter Property="Padding" Value="12,5"/>
            <Setter Property="MinHeight" Value="37"/>
            <Setter Property="HorizontalContentAlignment" Value="Center"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Frame" Background="{TemplateBinding Background}" CornerRadius="10"
                                BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="1" RenderTransformOrigin=".5,.5">
                            <Border.RenderTransform><ScaleTransform x:Name="PressScale"/></Border.RenderTransform>
                            <VisualStateManager.VisualStateGroups>
                                <VisualStateGroup x:Name="CommonStates">
                                    <VisualStateGroup.Transitions>
                                        <VisualTransition GeneratedDuration="0:0:0.11"/>
                                    </VisualStateGroup.Transitions>
                                    <VisualState x:Name="Normal"/>
                                    <VisualState x:Name="MouseOver">
                                        <Storyboard><DoubleAnimation Storyboard.TargetName="Tint" Storyboard.TargetProperty="Opacity" To="0.45" Duration="0"/></Storyboard>
                                    </VisualState>
                                    <VisualState x:Name="Pressed">
                                        <Storyboard>
                                            <DoubleAnimation Storyboard.TargetName="Tint" Storyboard.TargetProperty="Opacity" To="0.7" Duration="0"/>
                                            <DoubleAnimation Storyboard.TargetName="PressScale" Storyboard.TargetProperty="ScaleX" To="0.98" Duration="0"/>
                                            <DoubleAnimation Storyboard.TargetName="PressScale" Storyboard.TargetProperty="ScaleY" To="0.98" Duration="0"/>
                                        </Storyboard>
                                    </VisualState>
                                    <VisualState x:Name="Disabled">
                                        <Storyboard><DoubleAnimation Storyboard.TargetName="Frame" Storyboard.TargetProperty="Opacity" To="0.72" Duration="0"/></Storyboard>
                                    </VisualState>
                                </VisualStateGroup>
                            </VisualStateManager.VisualStateGroups>
                            <Grid>
                                <Border x:Name="Tint" Background="#25F9D8B6" Opacity="0" CornerRadius="9" IsHitTestVisible="False"/>
                                <ContentPresenter x:Name="ButtonContent" Margin="{TemplateBinding Padding}" HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                                  VerticalAlignment="Center" RecognizesAccessKey="True"/>
                            </Grid>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="Frame" Property="BorderBrush" Value="{StaticResource Amber}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="Primary" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
            <Setter Property="Background" Value="{StaticResource PrimarySurface}"/>
            <Setter Property="BorderBrush" Value="{StaticResource Amber}"/>
            <Setter Property="Foreground" Value="{StaticResource Paper}"/>
            <Setter Property="MinHeight" Value="42"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
        </Style>
        <Style x:Key="HomeAction" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
            <Setter Property="Height" Value="66"/>
            <Setter Property="Width" Value="174"/>
            <Setter Property="FontSize" Value="18"/>
            <Setter Property="FontWeight" Value="Medium"/>
            <Setter Property="Padding" Value="9,5"/>
            <Setter Property="BorderBrush" Value="{StaticResource GlassRim}"/>
        </Style>
        <Style x:Key="HomePrimary" TargetType="Button" BasedOn="{StaticResource HomeAction}">
            <Setter Property="Background" Value="{StaticResource CopperGlass}"/>
            <Setter Property="BorderBrush" Value="{StaticResource CopperRim}"/>
        </Style>
        <Style x:Key="ShortcutButton" TargetType="Button" BasedOn="{StaticResource IconButton}">
            <Setter Property="Width" Value="Auto"/>
            <Setter Property="Height" Value="Auto"/>
            <Setter Property="MinHeight" Value="26"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="Foreground" Value="{StaticResource Paper}"/>
            <Setter Property="HorizontalAlignment" Value="Left"/>
            <Setter Property="FontFamily" Value="Segoe UI Variable Text, Microsoft YaHei UI"/>
        </Style>
        <Style TargetType="ComboBox">
            <Setter Property="Foreground" Value="{StaticResource Paper}"/>
            <Setter Property="Background" Value="{StaticResource InputSurface}"/>
            <Setter Property="Height" Value="41"/>
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Setter Property="ItemContainerStyle">
                <Setter.Value>
                    <Style TargetType="ComboBoxItem">
                        <Setter Property="Foreground" Value="{StaticResource Paper}"/>
                        <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                        <Setter Property="Template">
                            <Setter.Value>
                                <ControlTemplate TargetType="ComboBoxItem">
                                    <Border x:Name="ItemFrame" Padding="10,7" Background="Transparent">
                                        <ContentPresenter/>
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsHighlighted" Value="True">
                                            <Setter TargetName="ItemFrame" Property="Background" Value="{StaticResource HoverSurface}"/>
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Setter.Value>
                        </Setter>
                    </Style>
                </Setter.Value>
            </Setter>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ComboBox">
                        <Grid>
                            <ToggleButton Focusable="False" ClickMode="Press"
                                          IsChecked="{Binding IsDropDownOpen, RelativeSource={RelativeSource TemplatedParent}, Mode=TwoWay}">
                                <ToggleButton.Template>
                                    <ControlTemplate TargetType="ToggleButton">
                                        <Border Background="{StaticResource InputSurface}" BorderBrush="{StaticResource Line}"
                                                CornerRadius="7" BorderThickness="1">
                                            <Path Data="{StaticResource ChevronDownIcon}" Style="{StaticResource ActionIcon}"
                                                  Width="10" Height="10" HorizontalAlignment="Right" Margin="0,0,11,0"/>
                                        </Border>
                                    </ControlTemplate>
                                </ToggleButton.Template>
                            </ToggleButton>
                            <ContentPresenter Margin="11,0,26,0" VerticalAlignment="Center" IsHitTestVisible="False"
                                              Content="{TemplateBinding SelectionBoxItem}"
                                              ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}"/>
                            <Border x:Name="ComboFocus" IsHitTestVisible="False" CornerRadius="7"
                                    BorderThickness="1" BorderBrush="{StaticResource Amber}" Visibility="Collapsed"/>
                            <Popup x:Name="PART_Popup" Placement="Bottom" AllowsTransparency="True"
                                   IsOpen="{TemplateBinding IsDropDownOpen}" Focusable="False" PopupAnimation="Fade">
                                <Border MinWidth="{Binding ActualWidth, RelativeSource={RelativeSource TemplatedParent}}"
                                        MaxHeight="220" Background="{StaticResource PopupSurface}" CornerRadius="7"
                                        BorderBrush="{StaticResource Line}" BorderThickness="1" Margin="0,3,0,0">
                                    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                                        <ItemsPresenter KeyboardNavigation.DirectionalNavigation="Contained"/>
                                    </ScrollViewer>
                                </Border>
                            </Popup>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsKeyboardFocusWithin" Value="True">
                                <Setter TargetName="ComboFocus" Property="Visibility" Value="Visible"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>
    <Border BorderBrush="{StaticResource GlassRim}" BorderThickness="1" CornerRadius="12">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="40"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>
            <Border BorderThickness="0,0,0,1" BorderBrush="{StaticResource Line}" Background="{StaticResource TitleSurface}"
                    MouseLeftButtonDown="DragHeader">
                <DockPanel Margin="17,0,5,0" LastChildFill="True">
                    <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                        <Button x:Name="HeaderPreferences" Click="PreferencesClicked" ToolTip="设置" AutomationProperties.Name="设置"
                                Style="{StaticResource CaptionButton}">
                            <Path Data="{StaticResource SettingsIcon}" Style="{StaticResource ActionIcon}" Width="18" Height="18"
                                  Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"/>
                        </Button>
                        <Button x:Name="HeaderHide" Click="HideClicked" ToolTip="收起到托盘" AutomationProperties.Name="收起到托盘"
                                Style="{StaticResource CaptionButton}">
                            <Path Data="{StaticResource HideIcon}" Style="{StaticResource ActionIcon}" Width="18" Height="18"
                                  Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"/>
                        </Button>
                        <Button x:Name="HeaderClose" Click="CloseClicked" ToolTip="退出营地聊天" AutomationProperties.Name="退出营地聊天"
                                Style="{StaticResource CaptionClose}">
                            <Path Data="{StaticResource CloseIcon}" Style="{StaticResource ActionIcon}" Width="15" Height="15" StrokeThickness="1.4"
                                  Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"/>
                        </Button>
                    </StackPanel>
                    <Button x:Name="BackButton" DockPanel.Dock="Left" Width="25" Height="34" Padding="2" Margin="-9,0,9,0" Click="BackClicked" ToolTip="返回"
                            AutomationProperties.Name="返回" Style="{StaticResource IconButton}" Visibility="Collapsed">
                        <Path Data="{StaticResource BackIcon}" Style="{StaticResource ActionIcon}" Stroke="{StaticResource Paper}"/>
                    </Button>
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center" IsHitTestVisible="False">
                        <TextBlock x:Name="HeaderTitle" Text="营地聊天" VerticalAlignment="Center"
                                   FontSize="19" FontWeight="Medium"/>
                    </StackPanel>
                </DockPanel>
            </Border>

            <Grid Grid.Row="1" Margin="17,7,17,7">
                <Grid.RowDefinitions>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>
                <Grid x:Name="Stage" ClipToBounds="True">
                    <ScrollViewer x:Name="WelcomePanel" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                    <WrapPanel HorizontalAlignment="Center" VerticalAlignment="Center" Margin="0,17,0,4">
                        <Button x:Name="CreateEntry" Click="OpenCreateClicked" Style="{StaticResource HomePrimary}" Margin="0,0,16,4"
                                AutomationProperties.Name="创建房间">
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                <Path Data="{StaticResource CreateRoomIcon}" Style="{StaticResource ActionIcon}" Width="38" Height="38"
                                      Stroke="{StaticResource Paper}" Margin="0,0,12,0"/>
                                <TextBlock Text="创建房间" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>
                        <Button x:Name="JoinEntry" Click="OpenJoinClicked" Style="{StaticResource HomeAction}" Margin="0,0,0,4"
                                AutomationProperties.Name="加入房间">
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                <Path Data="{StaticResource JoinRoomIcon}" Style="{StaticResource ActionIcon}" Width="38" Height="38"
                                      Stroke="{StaticResource Paper}" Margin="0,0,12,0"/>
                                <TextBlock Text="加入房间" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>
                    </WrapPanel>
                    </ScrollViewer>

                    <Grid x:Name="SetupPanel" Visibility="Collapsed">
                        <ScrollViewer x:Name="CreateFields" Visibility="Collapsed" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                        <StackPanel>
                            <Label Target="{Binding ElementName=Nickname}" Content="昵称" Foreground="{StaticResource Muted}" Padding="0,0,0,5"/>
                            <TextBox x:Name="Nickname" MaxLength="24" Width="178" HorizontalAlignment="Left" AutomationProperties.Name="你的昵称"/>
                            <Label Target="{Binding ElementName=Adapters}" Content="建房网卡" Foreground="{StaticResource Muted}" Padding="0,0,0,5" Margin="0,13,0,0"/>
                            <DockPanel>
                                <Button DockPanel.Dock="Right" Margin="7,0,0,0" Click="RefreshClicked"
                                        ToolTip="刷新网卡" AutomationProperties.Name="刷新网卡" Style="{StaticResource IconButton}">
                                    <Path Data="{StaticResource RefreshIcon}" Style="{StaticResource ActionIcon}"/>
                                </Button>
                                <ComboBox x:Name="Adapters" AutomationProperties.Name="选择网卡"/>
                            </DockPanel>
                            <TextBlock x:Name="NetworkTip" Margin="1,6,0,0" FontSize="12" Foreground="{StaticResource Muted}" TextWrapping="Wrap"/>
                            <Button x:Name="HostButton" Content="创建房间" Click="HostClicked" Style="{StaticResource Primary}"
                                    HorizontalAlignment="Left" Padding="16,7" MinWidth="100" Margin="0,14,0,0"/>
                        </StackPanel>
                        </ScrollViewer>
                        <ScrollViewer x:Name="JoinFields" Visibility="Collapsed" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                        <StackPanel>
                            <Label Target="{Binding ElementName=JoinNickname}" Content="昵称" Foreground="{StaticResource Muted}" Padding="0,0,0,5"/>
                            <TextBox x:Name="JoinNickname" Text="{Binding Text, ElementName=Nickname, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                     MaxLength="24" Width="178" HorizontalAlignment="Left" AutomationProperties.Name="你的昵称"/>
                            <Label Target="{Binding ElementName=JoinCode}" Content="房间码" Foreground="{StaticResource Muted}" Padding="0,0,0,5" Margin="0,13,0,0"/>
                            <TextBox x:Name="JoinCode" MaxLength="152" AutomationProperties.Name="房间码"/>
                            <Button x:Name="JoinButton" Content="加入房间" Click="JoinClicked" Style="{StaticResource Primary}"
                                    HorizontalAlignment="Left" Padding="16,7" MinWidth="100" Margin="0,14,0,0"/>
                        </StackPanel>
                        </ScrollViewer>
                    </Grid>

                    <Grid x:Name="ChatPanel" Visibility="Collapsed">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>
                        <DockPanel Margin="0,0,0,12" LastChildFill="True">
                            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                                <Button x:Name="CopyInvite" Content="复制房间码" Click="CopyClicked" Margin="6,0,0,0"/>
                                <Button x:Name="LeaveButton" Content="离开" Click="LeaveClicked" Margin="6,0,0,0"/>
                            </StackPanel>
                            <TextBlock x:Name="RoomLabel" Text="房间" FontWeight="SemiBold" VerticalAlignment="Center"
                                       Foreground="{StaticResource SoftAccent}" TextTrimming="CharacterEllipsis"/>
                        </DockPanel>
                        <Border Grid.Row="1" Background="{StaticResource InputSurface}" BorderThickness="1"
                                BorderBrush="{StaticResource Line}" CornerRadius="8">
                            <ScrollViewer x:Name="ChatScroll" Padding="11,8" VerticalScrollBarVisibility="Auto">
                                <ItemsControl x:Name="ChatHistory">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <StackPanel Margin="0,0,0,10">
                                                <StackPanel Orientation="Horizontal">
                                                    <TextBlock Text="{Binding Name}" Foreground="{StaticResource Amber}" FontWeight="SemiBold"/>
                                                    <TextBlock Text="{Binding Time}" FontSize="12" Foreground="{StaticResource Muted}" Margin="7,1,0,0"/>
                                                </StackPanel>
                                                <TextBlock Text="{Binding Text}" TextWrapping="Wrap" Margin="0,2,0,0"/>
                                            </StackPanel>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </ScrollViewer>
                        </Border>
                        <DockPanel Grid.Row="2" Margin="0,9,0,0" LastChildFill="True">
                            <Button x:Name="SendButton" DockPanel.Dock="Right" Click="SendClicked" ToolTip="发送"
                                    AutomationProperties.Name="发送" Style="{StaticResource IconButton}" Margin="5,0,0,0">
                                <Path Data="{StaticResource SendIcon}" Style="{StaticResource ActionIcon}" Stroke="{StaticResource Amber}"/>
                            </Button>
                            <TextBox x:Name="Composer" MaxLength="400" AutomationProperties.Name="输入消息"/>
                        </DockPanel>
                    </Grid>

                    <ScrollViewer x:Name="PreferencesPanel" Visibility="Collapsed" VerticalScrollBarVisibility="Auto"
                                  HorizontalScrollBarVisibility="Disabled">
                        <StackPanel>
                            <GroupBox x:Name="HotkeyGroup" Style="{StaticResource SettingsGroup}" AutomationProperties.Name="快捷键" Margin="0,0,0,6">
                                <GroupBox.Header>
                                    <StackPanel Orientation="Horizontal">
                                        <Path Data="{StaticResource KeyboardIcon}" Style="{StaticResource ActionIcon}"
                                              Stroke="{StaticResource SoftAccent}" Margin="0,0,6,0"/>
                                        <TextBlock Text="快捷键" FontSize="16" FontWeight="Medium" VerticalAlignment="Center"/>
                                    </StackPanel>
                                </GroupBox.Header>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="93"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                    </Grid.RowDefinitions>
                                    <TextBlock Text="打字聊天" Style="{StaticResource SettingsLabel}"/>
                                    <Button x:Name="ComposeKeyButton" Grid.Column="1" Margin="0,0,0,2" Click="CaptureComposeClicked"
                                            Style="{StaticResource ShortcutButton}" AutomationProperties.Name="设置打字聊天快捷键"
                                            ToolTip="点击后按新的组合键"/>
                                    <TextBlock Grid.Row="1" Text="打开设置" Style="{StaticResource SettingsLabel}"/>
                                    <Button x:Name="RoomKeyButton" Grid.Row="1" Grid.Column="1" Click="CaptureRoomClicked"
                                            Style="{StaticResource ShortcutButton}" AutomationProperties.Name="设置房间设置快捷键"
                                            ToolTip="点击后按新的组合键"/>
                                </Grid>
                            </GroupBox>
                            <GroupBox x:Name="DisplayGroup" Style="{StaticResource SettingsGroup}" AutomationProperties.Name="游戏显示">
                                <GroupBox.Header>
                                    <StackPanel Orientation="Horizontal">
                                        <Path Data="{StaticResource ScreenIcon}" Style="{StaticResource ActionIcon}"
                                              Stroke="{StaticResource SoftAccent}" Margin="0,0,6,0"/>
                                        <TextBlock Text="游戏显示" FontSize="16" FontWeight="Medium" VerticalAlignment="Center"/>
                                    </StackPanel>
                                </GroupBox.Header>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="93"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="80"/>
                                    </Grid.ColumnDefinitions>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="28"/>
                                        <RowDefinition Height="28"/>
                                        <RowDefinition Height="28"/>
                                    </Grid.RowDefinitions>
                                    <TextBlock Text="字幕布局" Style="{StaticResource SettingsLabel}"/>
                                    <ComboBox x:Name="LayoutPicker" Grid.Column="1" FontSize="14" FontWeight="Medium" Height="25"
                                              SelectionChanged="PreferencesChanged" AutomationProperties.Name="游戏内字幕布局">
                                        <ComboBoxItem Content="底部左侧" ToolTip="显示最近三条消息"/>
                                        <ComboBoxItem Content="屏幕右侧" ToolTip="显示最新一条消息"/>
                                    </ComboBox>
                                    <TextBlock Grid.Row="1" Text="游戏窗口" Style="{StaticResource SettingsLabel}"/>
                                    <Grid Grid.Row="1" Grid.Column="1">
                                        <ComboBox x:Name="GameWindowPicker" FontSize="14" FontWeight="Medium" Height="25" DropDownOpened="GameWindowsOpened"
                                                  SelectionChanged="GameWindowChanged" AutomationProperties.Name="选择游戏窗口"
                                                  ToolTip="打开列表会刷新当前窗口。">
                                            <ComboBox.ItemTemplate>
                                                <DataTemplate><TextBlock Text="{Binding Title}" TextTrimming="CharacterEllipsis" ToolTip="{Binding Title}"/></DataTemplate>
                                            </ComboBox.ItemTemplate>
                                        </ComboBox>
                                        <TextBlock Text="选择窗口" FontSize="14" Foreground="{StaticResource Muted}" Margin="11,0,26,0"
                                                   VerticalAlignment="Center" IsHitTestVisible="False" TextTrimming="CharacterEllipsis">
                                            <TextBlock.Style>
                                                <Style TargetType="TextBlock">
                                                    <Setter Property="Visibility" Value="Collapsed"/>
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding SelectedIndex, ElementName=GameWindowPicker}" Value="-1">
                                                            <Setter Property="Visibility" Value="Visible"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBlock.Style>
                                        </TextBlock>
                                    </Grid>
                                    <Button x:Name="BorderlessButton" Grid.Row="1" Grid.Column="2" Content="铺满屏幕"
                                            Height="25" MinHeight="25" Click="BorderlessClicked" IsEnabled="False"
                                            Padding="3,0" FontSize="14" FontWeight="Medium" Margin="8,0,0,0"
                                            HorizontalContentAlignment="Center" Foreground="{StaticResource CopperInk}"
                                            BorderBrush="{StaticResource CopperRim}" Background="{StaticResource WindowModeSurface}"
                                            ToolTip="先把游戏切到窗口模式，再铺满屏幕。" ToolTipService.ShowOnDisabled="True"/>
                                    <CheckBox x:Name="MotionEnabled" Grid.Row="2" Grid.ColumnSpan="3" Content="界面动效"
                                              Style="{StaticResource PreferenceSwitch}" AutomationProperties.Name="界面动效"
                                              Checked="PreferencesChanged" Unchecked="PreferencesChanged"/>
                                </Grid>
                            </GroupBox>
                        </StackPanel>
                    </ScrollViewer>
                </Grid>
                <StackPanel Grid.Row="1">
                    <ProgressBar x:Name="ConnectionProgress" Height="2" IsIndeterminate="False" Visibility="Collapsed"
                                 Foreground="{StaticResource Amber}" Background="{StaticResource Line}" Margin="0,7,0,0"/>
                    <TextBlock x:Name="Status" Margin="1,7,0,0" FontSize="12" Foreground="{StaticResource Muted}"
                               TextWrapping="Wrap" AutomationProperties.LiveSetting="Polite">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock">
                                <Style.Triggers>
                                    <Trigger Property="Text" Value=""><Setter Property="Visibility" Value="Collapsed"/></Trigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                </StackPanel>
            </Grid>
        </Grid>
    </Border>
</Window>
