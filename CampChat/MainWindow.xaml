<Window x:Class="CampChat.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        Title="营地聊天" Width="380" Height="145" MinWidth="320" MinHeight="145" WindowStyle="None" ResizeMode="CanResize"
        Icon="Assets/CampChat.ico" Topmost="True" Background="{StaticResource ShellSurface}" Foreground="{StaticResource Paper}"
        Language="zh-CN" FontFamily="Noto Sans SC, DengXian, Segoe UI" FontSize="14"
        UseLayoutRounding="True" SnapsToDevicePixels="True" TextOptions.TextFormattingMode="Display"
        SourceInitialized="OnSourceInitialized" Loaded="OnLoaded" PreviewKeyDown="OnPreviewKeyDown" Closing="OnClosing">
    <shell:WindowChrome.WindowChrome>
        <shell:WindowChrome CaptionHeight="0" ResizeBorderThickness="6" GlassFrameThickness="0"/>
    </shell:WindowChrome.WindowChrome>
    <Window.Resources>
        <Style x:Key="ScrollTrackButton" TargetType="RepeatButton">
            <Setter Property="Focusable" Value="False"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RepeatButton"><Border Background="Transparent"/></ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style TargetType="ScrollBar">
            <Setter Property="Width" Value="11"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Focusable" Value="False"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ScrollBar">
                        <Grid Background="{TemplateBinding Background}" Margin="2,4,2,4">
                            <Border CornerRadius="3" Background="{StaticResource ControlSurface}" Opacity="0.6"/>
                            <Track x:Name="PART_Track" IsDirectionReversed="True">
                                <Track.DecreaseRepeatButton>
                                    <RepeatButton Style="{StaticResource ScrollTrackButton}" Command="ScrollBar.PageUpCommand"/>
                                </Track.DecreaseRepeatButton>
                                <Track.Thumb>
                                    <Thumb>
                                        <Thumb.Template>
                                            <ControlTemplate TargetType="Thumb">
                                                <Border x:Name="Grip" CornerRadius="4" Background="#8E6C51"/>
                                                <ControlTemplate.Triggers>
                                                    <Trigger Property="IsMouseOver" Value="True">
                                                        <Setter TargetName="Grip" Property="Background" Value="{StaticResource SoftAccent}"/>
                                                    </Trigger>
                                                    <Trigger Property="IsDragging" Value="True">
                                                        <Setter TargetName="Grip" Property="Background" Value="{StaticResource Amber}"/>
                                                    </Trigger>
                                                </ControlTemplate.Triggers>
                                            </ControlTemplate>
                                        </Thumb.Template>
                                    </Thumb>
                                </Track.Thumb>
                                <Track.IncreaseRepeatButton>
                                    <RepeatButton Style="{StaticResource ScrollTrackButton}" Command="ScrollBar.PageDownCommand"/>
                                </Track.IncreaseRepeatButton>
                            </Track>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="Heading" TargetType="TextBlock">
            <Setter Property="FontSize" Value="15"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
        </Style>
        <Style x:Key="SettingsGroup" TargetType="GroupBox">
            <Setter Property="Foreground" Value="{StaticResource Paper}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="GroupBox">
                        <Grid>
                            <Border Margin="0,9,0,0" CornerRadius="9" BorderThickness="1" BorderBrush="{StaticResource Line}">
                                <ContentPresenter Margin="11,16,11,10"/>
                            </Border>
                            <Border Margin="9,0,0,0" Padding="5,0" Background="{StaticResource ShellSurface}"
                                    HorizontalAlignment="Left" VerticalAlignment="Top">
                                <ContentPresenter ContentSource="Header"/>
                            </Border>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="SettingsLabel" TargetType="TextBlock">
            <Setter Property="Width" Value="86"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>
        <DataTemplate x:Key="ShortcutKeycaps">
            <ItemsControl ItemsSource="{Binding}">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate><StackPanel Orientation="Horizontal"/></ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border Background="{StaticResource ControlSurface}" BorderBrush="{StaticResource Line}" BorderThickness="1"
                                CornerRadius="4" MinWidth="25" Padding="6,1" Margin="0,0,4,0">
                            <TextBlock Text="{Binding}" FontSize="12" Foreground="{StaticResource Paper}"
                                       TextAlignment="Center"/>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </DataTemplate>
        <Style TargetType="TextBox">
            <Setter Property="Foreground" Value="{StaticResource Paper}"/>
            <Setter Property="Background" Value="{StaticResource InputSurface}"/>
            <Setter Property="BorderBrush" Value="{StaticResource Line}"/>
            <Setter Property="CaretBrush" Value="{StaticResource Amber}"/>
            <Setter Property="Padding" Value="11,0"/>
            <Setter Property="Height" Value="38"/>
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TextBox">
                        <Border x:Name="FieldFrame" Background="{TemplateBinding Background}" CornerRadius="7"
                                BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="1">
                            <ScrollViewer x:Name="PART_ContentHost" VerticalAlignment="Center"
                                          Margin="{TemplateBinding Padding}"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="FieldFrame" Property="BorderBrush" Value="{StaticResource Amber}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style TargetType="Button">
            <Setter Property="Foreground" Value="{StaticResource Paper}"/>
            <Setter Property="Background" Value="{StaticResource ControlSurface}"/>
            <Setter Property="BorderBrush" Value="{StaticResource Line}"/>
            <Setter Property="Padding" Value="12,5"/>
            <Setter Property="MinHeight" Value="34"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Frame" Background="{TemplateBinding Background}" CornerRadius="10"
                                BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="1" RenderTransformOrigin=".5,.5">
                            <Border.RenderTransform><ScaleTransform x:Name="PressScale"/></Border.RenderTransform>
                            <VisualStateManager.VisualStateGroups>
                                <VisualStateGroup x:Name="CommonStates">
                                    <VisualStateGroup.Transitions>
                                        <VisualTransition GeneratedDuration="0:0:0.11"/>
                                    </VisualStateGroup.Transitions>
                                    <VisualState x:Name="Normal"/>
                                    <VisualState x:Name="MouseOver">
                                        <Storyboard><DoubleAnimation Storyboard.TargetName="Tint" Storyboard.TargetProperty="Opacity" To="0.45" Duration="0"/></Storyboard>
                                    </VisualState>
                                    <VisualState x:Name="Pressed">
                                        <Storyboard>
                                            <DoubleAnimation Storyboard.TargetName="Tint" Storyboard.TargetProperty="Opacity" To="0.7" Duration="0"/>
                                            <DoubleAnimation Storyboard.TargetName="PressScale" Storyboard.TargetProperty="ScaleX" To="0.98" Duration="0"/>
                                            <DoubleAnimation Storyboard.TargetName="PressScale" Storyboard.TargetProperty="ScaleY" To="0.98" Duration="0"/>
                                        </Storyboard>
                                    </VisualState>
                                    <VisualState x:Name="Disabled">
                                        <Storyboard><DoubleAnimation Storyboard.TargetName="Frame" Storyboard.TargetProperty="Opacity" To="0.56" Duration="0"/></Storyboard>
                                    </VisualState>
                                </VisualStateGroup>
                            </VisualStateManager.VisualStateGroups>
                            <Grid>
                                <Border x:Name="Tint" Background="#25F9D8B6" Opacity="0" CornerRadius="9" IsHitTestVisible="False"/>
                                <ContentPresenter Margin="{TemplateBinding Padding}" HorizontalAlignment="Stretch"
                                                  VerticalAlignment="Center" RecognizesAccessKey="True"/>
                            </Grid>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="Frame" Property="BorderBrush" Value="{StaticResource Amber}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="Primary" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
            <Setter Property="Background" Value="{StaticResource PrimarySurface}"/>
            <Setter Property="BorderBrush" Value="{StaticResource Amber}"/>
            <Setter Property="Foreground" Value="{StaticResource Paper}"/>
            <Setter Property="MinHeight" Value="39"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
        </Style>
        <Style x:Key="HomeAction" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
            <Setter Property="MinHeight" Value="54"/>
            <Setter Property="MinWidth" Value="138"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Padding" Value="13,8"/>
        </Style>
        <Style x:Key="HomePrimary" TargetType="Button" BasedOn="{StaticResource HomeAction}">
            <Setter Property="Background" Value="{StaticResource PrimarySurface}"/>
            <Setter Property="BorderBrush" Value="{StaticResource Amber}"/>
            <Setter Property="Foreground" Value="{StaticResource Paper}"/>
        </Style>
        <Style TargetType="ComboBox">
            <Setter Property="Foreground" Value="{StaticResource Paper}"/>
            <Setter Property="Background" Value="{StaticResource InputSurface}"/>
            <Setter Property="Height" Value="38"/>
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Setter Property="ItemContainerStyle">
                <Setter.Value>
                    <Style TargetType="ComboBoxItem">
                        <Setter Property="Foreground" Value="{StaticResource Paper}"/>
                        <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                        <Setter Property="Template">
                            <Setter.Value>
                                <ControlTemplate TargetType="ComboBoxItem">
                                    <Border x:Name="ItemFrame" Padding="10,7" Background="Transparent">
                                        <ContentPresenter/>
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsHighlighted" Value="True">
                                            <Setter TargetName="ItemFrame" Property="Background" Value="{StaticResource HoverSurface}"/>
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Setter.Value>
                        </Setter>
                    </Style>
                </Setter.Value>
            </Setter>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ComboBox">
                        <Grid>
                            <ToggleButton Focusable="False" ClickMode="Press"
                                          IsChecked="{Binding IsDropDownOpen, RelativeSource={RelativeSource TemplatedParent}, Mode=TwoWay}">
                                <ToggleButton.Template>
                                    <ControlTemplate TargetType="ToggleButton">
                                        <Border Background="{StaticResource InputSurface}" BorderBrush="{StaticResource Line}"
                                                CornerRadius="7" BorderThickness="1">
                                            <Path Data="{StaticResource ChevronDownIcon}" Style="{StaticResource ActionIcon}"
                                                  Width="10" Height="10" HorizontalAlignment="Right" Margin="0,0,11,0"/>
                                        </Border>
                                    </ControlTemplate>
                                </ToggleButton.Template>
                            </ToggleButton>
                            <ContentPresenter Margin="11,0,26,0" VerticalAlignment="Center" IsHitTestVisible="False"
                                              Content="{TemplateBinding SelectionBoxItem}"
                                              ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}"/>
                            <Border x:Name="ComboFocus" IsHitTestVisible="False" CornerRadius="7"
                                    BorderThickness="1" BorderBrush="{StaticResource Amber}" Visibility="Collapsed"/>
                            <Popup x:Name="PART_Popup" Placement="Bottom" AllowsTransparency="True"
                                   IsOpen="{TemplateBinding IsDropDownOpen}" Focusable="False" PopupAnimation="Fade">
                                <Border MinWidth="{Binding ActualWidth, RelativeSource={RelativeSource TemplatedParent}}"
                                        MaxHeight="220" Background="{StaticResource ControlSurface}" CornerRadius="7"
                                        BorderBrush="{StaticResource Line}" BorderThickness="1" Margin="0,3,0,0">
                                    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                                        <ItemsPresenter KeyboardNavigation.DirectionalNavigation="Contained"/>
                                    </ScrollViewer>
                                </Border>
                            </Popup>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsKeyboardFocusWithin" Value="True">
                                <Setter TargetName="ComboFocus" Property="Visibility" Value="Visible"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>
    <Border BorderBrush="{StaticResource Line}" BorderThickness="1" CornerRadius="10">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="49"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>
            <Border BorderThickness="0,0,0,1" BorderBrush="{StaticResource Line}" Background="{StaticResource TitleSurface}"
                    MouseLeftButtonDown="DragHeader">
                <DockPanel Margin="13,0,8,0" LastChildFill="True">
                    <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                        <Button x:Name="HeaderPreferences" Click="PreferencesClicked" ToolTip="设置" AutomationProperties.Name="设置"
                                Style="{StaticResource CaptionButton}">
                            <Path Data="{StaticResource SettingsIcon}" Style="{StaticResource ActionIcon}" Width="18" Height="18"
                                  Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"/>
                        </Button>
                        <Button x:Name="HeaderHide" Click="HideClicked" ToolTip="收起到托盘" AutomationProperties.Name="收起到托盘"
                                Style="{StaticResource CaptionButton}">
                            <Path Data="{StaticResource HideIcon}" Style="{StaticResource ActionIcon}" Width="18" Height="18"
                                  Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"/>
                        </Button>
                        <Button x:Name="HeaderClose" Click="CloseClicked" ToolTip="退出营地聊天" AutomationProperties.Name="退出营地聊天"
                                Style="{StaticResource CaptionClose}">
                            <Path Data="{StaticResource CloseIcon}" Style="{StaticResource ActionIcon}" Width="18" Height="18"
                                  Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"/>
                        </Button>
                    </StackPanel>
                    <Button x:Name="BackButton" DockPanel.Dock="Left" Click="BackClicked" ToolTip="返回"
                            AutomationProperties.Name="返回" Style="{StaticResource IconButton}" Visibility="Collapsed">
                        <Path Data="{StaticResource BackIcon}" Style="{StaticResource ActionIcon}" Stroke="{StaticResource Paper}"/>
                    </Button>
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center" IsHitTestVisible="False">
                        <Border x:Name="Mark" Width="27" Height="27" CornerRadius="7" Background="{StaticResource HoverSurface}" Margin="0,0,9,0">
                            <Path Data="{StaticResource MessageIcon}" Style="{StaticResource ActionIcon}" Stroke="{StaticResource Amber}"/>
                        </Border>
                        <TextBlock x:Name="HeaderTitle" Text="营地聊天" VerticalAlignment="Center" Style="{StaticResource Heading}"/>
                    </StackPanel>
                </DockPanel>
            </Border>

            <Grid Grid.Row="1" Margin="19,15,19,15">
                <Grid.RowDefinitions>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>
                <Grid x:Name="Stage" ClipToBounds="True">
                    <ScrollViewer x:Name="WelcomePanel" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                    <WrapPanel HorizontalAlignment="Center" VerticalAlignment="Top" Margin="0,3,0,0">
                        <Button x:Name="CreateEntry" Click="OpenCreateClicked" Style="{StaticResource HomePrimary}" Margin="0,0,10,4"
                                AutomationProperties.Name="创建房间">
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                <Path Data="{StaticResource CreateRoomIcon}" Style="{StaticResource ActionIcon}" Width="22" Height="22"
                                      Stroke="{StaticResource Amber}" Margin="0,0,10,0"/>
                                <TextBlock Text="创建房间" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>
                        <Button x:Name="JoinEntry" Click="OpenJoinClicked" Style="{StaticResource HomeAction}" Margin="0,0,0,4"
                                AutomationProperties.Name="加入房间">
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                <Path Data="{StaticResource JoinRoomIcon}" Style="{StaticResource ActionIcon}" Width="22" Height="22"
                                      Stroke="{StaticResource SoftAccent}" Margin="0,0,10,0"/>
                                <TextBlock Text="加入房间" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>
                    </WrapPanel>
                    </ScrollViewer>

                    <Grid x:Name="SetupPanel" Visibility="Collapsed">
                        <ScrollViewer x:Name="CreateFields" Visibility="Collapsed" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                        <StackPanel>
                            <Label Target="{Binding ElementName=Nickname}" Content="昵称" Foreground="{StaticResource Muted}" Padding="0,0,0,5"/>
                            <TextBox x:Name="Nickname" MaxLength="24" Width="178" HorizontalAlignment="Left" AutomationProperties.Name="你的昵称"/>
                            <Label Target="{Binding ElementName=Adapters}" Content="建房网卡" Foreground="{StaticResource Muted}" Padding="0,0,0,5" Margin="0,13,0,0"/>
                            <DockPanel>
                                <Button DockPanel.Dock="Right" Margin="7,0,0,0" Click="RefreshClicked"
                                        ToolTip="刷新网卡" AutomationProperties.Name="刷新网卡" Style="{StaticResource IconButton}">
                                    <Path Data="{StaticResource RefreshIcon}" Style="{StaticResource ActionIcon}"/>
                                </Button>
                                <ComboBox x:Name="Adapters" AutomationProperties.Name="选择网卡"/>
                            </DockPanel>
                            <TextBlock x:Name="NetworkTip" Margin="1,6,0,0" FontSize="12" Foreground="{StaticResource Muted}" TextWrapping="Wrap"/>
                            <Button x:Name="HostButton" Content="创建房间" Click="HostClicked" Style="{StaticResource Primary}"
                                    HorizontalAlignment="Left" Padding="16,7" MinWidth="100" Margin="0,14,0,0"/>
                        </StackPanel>
                        </ScrollViewer>
                        <ScrollViewer x:Name="JoinFields" Visibility="Collapsed" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                        <StackPanel>
                            <Label Target="{Binding ElementName=JoinNickname}" Content="昵称" Foreground="{StaticResource Muted}" Padding="0,0,0,5"/>
                            <TextBox x:Name="JoinNickname" Text="{Binding Text, ElementName=Nickname, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                     MaxLength="24" Width="178" HorizontalAlignment="Left" AutomationProperties.Name="你的昵称"/>
                            <Label Target="{Binding ElementName=JoinCode}" Content="房间码" Foreground="{StaticResource Muted}" Padding="0,0,0,5" Margin="0,13,0,0"/>
                            <TextBox x:Name="JoinCode" MaxLength="152" AutomationProperties.Name="房间码"/>
                            <Button x:Name="JoinButton" Content="加入房间" Click="JoinClicked" Style="{StaticResource Primary}"
                                    HorizontalAlignment="Left" Padding="16,7" MinWidth="100" Margin="0,14,0,0"/>
                        </StackPanel>
                        </ScrollViewer>
                    </Grid>

                    <Grid x:Name="ChatPanel" Visibility="Collapsed">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>
                        <DockPanel Margin="0,0,0,12" LastChildFill="True">
                            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                                <Button x:Name="CopyInvite" Content="复制房间码" Click="CopyClicked" Margin="6,0,0,0"/>
                                <Button x:Name="LeaveButton" Content="离开" Click="LeaveClicked" Margin="6,0,0,0"/>
                            </StackPanel>
                            <TextBlock x:Name="RoomLabel" Text="房间" FontWeight="SemiBold" VerticalAlignment="Center"
                                       Foreground="{StaticResource SoftAccent}" TextTrimming="CharacterEllipsis"/>
                        </DockPanel>
                        <Border Grid.Row="1" Background="{StaticResource InputSurface}" BorderThickness="1"
                                BorderBrush="{StaticResource Line}" CornerRadius="8">
                            <ScrollViewer x:Name="ChatScroll" Padding="11,8" VerticalScrollBarVisibility="Auto">
                                <ItemsControl x:Name="ChatHistory">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <StackPanel Margin="0,0,0,10">
                                                <StackPanel Orientation="Horizontal">
                                                    <TextBlock Text="{Binding Name}" Foreground="{StaticResource Amber}" FontWeight="SemiBold"/>
                                                    <TextBlock Text="{Binding Time}" FontSize="12" Foreground="{StaticResource Muted}" Margin="7,1,0,0"/>
                                                </StackPanel>
                                                <TextBlock Text="{Binding Text}" TextWrapping="Wrap" Margin="0,2,0,0"/>
                                            </StackPanel>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </ScrollViewer>
                        </Border>
                        <DockPanel Grid.Row="2" Margin="0,9,0,0" LastChildFill="True">
                            <Button x:Name="SendButton" DockPanel.Dock="Right" Click="SendClicked" ToolTip="发送"
                                    AutomationProperties.Name="发送" Style="{StaticResource IconButton}" Margin="5,0,0,0">
                                <Path Data="{StaticResource SendIcon}" Style="{StaticResource ActionIcon}" Stroke="{StaticResource Amber}"/>
                            </Button>
                            <TextBox x:Name="Composer" MaxLength="400" AutomationProperties.Name="输入消息"/>
                        </DockPanel>
                    </Grid>

                    <ScrollViewer x:Name="PreferencesPanel" Visibility="Collapsed" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                    <StackPanel>
                        <GroupBox Style="{StaticResource SettingsGroup}" Margin="0,0,0,12" AutomationProperties.Name="快捷键">
                            <GroupBox.Header>
                                <StackPanel Orientation="Horizontal">
                                    <Path Data="{StaticResource KeyboardIcon}" Style="{StaticResource ActionIcon}" Stroke="{StaticResource SoftAccent}" Margin="0,0,6,0"/>
                                    <TextBlock Text="快捷键" Style="{StaticResource Heading}"/>
                                </StackPanel>
                            </GroupBox.Header>
                            <StackPanel>
                        <DockPanel Margin="0,0,0,6">
                            <TextBlock DockPanel.Dock="Left" Text="打字聊天" Style="{StaticResource SettingsLabel}"/>
                            <Button x:Name="ComposeKeyButton" Click="CaptureComposeClicked" MinHeight="36" MinWidth="110"
                                    HorizontalAlignment="Left" Padding="9,5"
                                    FontFamily="Segoe UI Variable Text, Segoe UI, Noto Sans SC, DengXian"
                                    AutomationProperties.Name="设置打字聊天快捷键" ToolTip="点击后按新的组合键"/>
                        </DockPanel>
                        <DockPanel>
                            <TextBlock DockPanel.Dock="Left" Text="打开设置" Style="{StaticResource SettingsLabel}"/>
                            <Button x:Name="RoomKeyButton" Click="CaptureRoomClicked" MinHeight="36" MinWidth="110"
                                    HorizontalAlignment="Left" Padding="9,5"
                                    FontFamily="Segoe UI Variable Text, Segoe UI, Noto Sans SC, DengXian"
                                    AutomationProperties.Name="设置房间设置快捷键" ToolTip="点击后按新的组合键"/>
                        </DockPanel>
                            </StackPanel>
                        </GroupBox>
                        <GroupBox Style="{StaticResource SettingsGroup}" AutomationProperties.Name="游戏显示">
                            <GroupBox.Header>
                                <StackPanel Orientation="Horizontal">
                                    <Path Data="{StaticResource ScreenIcon}" Style="{StaticResource ActionIcon}" Stroke="{StaticResource SoftAccent}" Margin="0,0,6,0"/>
                                    <TextBlock Text="游戏显示" Style="{StaticResource Heading}"/>
                                </StackPanel>
                            </GroupBox.Header>
                            <StackPanel>
                        <DockPanel Margin="0,0,0,10">
                            <TextBlock DockPanel.Dock="Left" Text="字幕布局" Style="{StaticResource SettingsLabel}"/>
                            <ComboBox x:Name="LayoutPicker" Width="174" HorizontalAlignment="Left" SelectionChanged="PreferencesChanged"
                                      AutomationProperties.Name="游戏内字幕布局">
                                <ComboBoxItem Content="左下角显示最近三条"/>
                                <ComboBoxItem Content="右侧显示最新一条"/>
                            </ComboBox>
                        </DockPanel>
                        <DockPanel Margin="0,0,0,6">
                            <TextBlock DockPanel.Dock="Left" Text="游戏窗口" Style="{StaticResource SettingsLabel}"/>
                            <Button DockPanel.Dock="Right" Click="RefreshWindowsClicked" Style="{StaticResource IconButton}"
                                    Margin="5,0,0,0" ToolTip="刷新窗口列表" AutomationProperties.Name="刷新窗口列表">
                                <Path Data="{StaticResource RefreshIcon}" Style="{StaticResource ActionIcon}"/>
                            </Button>
                            <ComboBox x:Name="GameWindowPicker" SelectionChanged="GameWindowChanged" AutomationProperties.Name="选择游戏窗口">
                                <ComboBox.ItemTemplate>
                                    <DataTemplate><TextBlock Text="{Binding Title}" TextTrimming="CharacterEllipsis" ToolTip="{Binding Title}"/></DataTemplate>
                                </ComboBox.ItemTemplate>
                            </ComboBox>
                        </DockPanel>
                        <DockPanel Margin="0,0,0,8">
                            <Button x:Name="BorderlessButton" DockPanel.Dock="Right" Content="铺满屏幕" MinHeight="36" Click="BorderlessClicked"
                                    Margin="8,0,0,0" IsEnabled="False" ToolTip="将所选窗口切为无边框全屏。"/>
                            <TextBlock Text="先把游戏切到窗口模式。" FontSize="12" Foreground="{StaticResource Muted}"
                                       VerticalAlignment="Center" TextWrapping="Wrap"/>
                        </DockPanel>
                        <CheckBox x:Name="MotionEnabled" Content="界面动效" Style="{StaticResource PreferenceSwitch}"
                                  HorizontalAlignment="Left" Width="171"
                                  AutomationProperties.Name="界面动效" Checked="PreferencesChanged" Unchecked="PreferencesChanged"/>
                            </StackPanel>
                        </GroupBox>
                    </StackPanel>
                    </ScrollViewer>
                </Grid>
                <StackPanel Grid.Row="1">
                    <ProgressBar x:Name="ConnectionProgress" Height="2" IsIndeterminate="False" Visibility="Collapsed"
                                 Foreground="{StaticResource Amber}" Background="{StaticResource Line}" Margin="0,7,0,0"/>
                    <TextBlock x:Name="Status" Margin="1,7,0,0" FontSize="12" Foreground="{StaticResource Muted}"
                               TextWrapping="Wrap" AutomationProperties.LiveSetting="Polite">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock">
                                <Style.Triggers>
                                    <Trigger Property="Text" Value=""><Setter Property="Visibility" Value="Collapsed"/></Trigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
